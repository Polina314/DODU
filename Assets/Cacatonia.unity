  m_Script: {fileID: 11500000, guid: f0bfee48b21b0bf4aa48877f623aec48, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438"
  title: "\u041B\u0438\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E. \u041F\u0430\u0446\u0438\u0435\u043D\u0442
    313"
  text: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u0438:
    \u043F\u043E\u0436\u0430\u0440 \u0432 \u043F\u0430\u043B\u0430\u0442\u0435 313.\r\n\u0422\u0435\u043B\u043E
    \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E.\r\n\r\n\u0420\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435
    \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0432\u0440\u0430\u0447\u0430:\r\n\u043F\u0430\u043B\u0430\u0442\u0443
    313 \u0437\u0430\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u0438\u0440\u043F\u0438\u0447\u043E\u043C
